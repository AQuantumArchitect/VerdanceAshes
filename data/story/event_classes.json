{
  "schemaVersion": "verdance-event-classes/0.1",
  "notes": "The event surface. An event class is a thing the world does that a person in the camp has the job of saying. Detectors run per bead (one history entry + its narrative event + its frontEvents + thread history at that turn) or on the final snapshot. Firing an event class does three things: names a witness (the concrete noun for the writer), applies coherence effects to reading pairs (what the event forced apart or left ambiguous), and gives the owning voice an occasion. Levels of readings never come from here; they come from probes in readings.json. Coherence only ever comes from here. cooldownBeads is hysteresis: a class that fired within that many beads stays quiet.",
  "occasions": [
    "briefing",
    "debrief",
    "camp",
    "roll"
  ],
  "classes": [
    {
      "id": "surprise_at_drop",
      "label": "What we briefed was not what we found",
      "owner": "yeva",
      "occasion": "debrief",
      "detect": {
        "scope": "bead",
        "surprise_gte": 0.6
      },
      "witness": "{label}: we believed {believed}; we found {found}. Our last word on it was stale.",
      "coherence": [
        {
          "pair": [
            "hunted",
            "armada_falling"
          ],
          "effect": "renew",
          "strength": 0.2
        }
      ],
      "cooldownBeads": 0,
      "note": "surprise is stamped on the bead by belief_homecoming_v1: sum over measured zones of belief confidence times |truth - belief|. Zero on a first visit (nobody had looked)."
    },
